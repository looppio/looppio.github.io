{
  "name": "oleksii-portfolio",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "build:pages": "npm run build && npm run prepare:pages",
    "prepare:pages": "node scripts/prepare-pages-build.mjs",
    "check:pages": "node scripts/check-pages-build.mjs",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:build": "node scripts/check-build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run check:assets && npm run build && npm test && npm run check:build"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "^0.180.0"
  },
  "description": "Oleksii Tyshchenko portfolio with a WebGL gallery and curated case studies.",
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "5.0.4",
    "esbuild": "0.25.12",
    "prettier": "3.6.2",
    "vite": "6.4.5"
  }
}
